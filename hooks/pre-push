#!/usr/bin/env bash
# Aru managed pre-push hook; installed by scripts/install_hooks.sh
set -euo pipefail

hook_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
prior="${hook_dir}/pre-push.pre-aru"
enforcer="${hook_dir}/enforce_touches.py"
if [[ ! -f "${enforcer}" || ! -f "${hook_dir}/touches.py" ]]; then
  echo "Aru: trusted installed hook or parser is missing; push refused." >&2
  exit 1
fi
input="$(cat)"
remote_target="${1:-origin}"
if ! remote_snapshot="$(git ls-remote --symref "${remote_target}" HEAD 'refs/heads/*')"; then
  echo "Aru: remote refs are unavailable; push refused." >&2
  exit 1
fi
if [[ -z "${remote_snapshot}" ]]; then
  nonempty_updates=0
  valid_bootstrap=1
  while read -r local_ref local_sha remote_ref remote_sha; do
    [[ -z "${local_ref:-}" ]] && continue
    nonempty_updates=$((nonempty_updates + 1))
    if [[ "${local_ref}" != refs/heads/* || "${remote_ref}" != refs/heads/* ||
          ! "${local_sha}" =~ ^[0-9a-fA-F]{40}$ ||
          "${local_sha}" == "0000000000000000000000000000000000000000" ||
          "${remote_sha}" != "0000000000000000000000000000000000000000" ]]; then
      valid_bootstrap=0
    fi
  done <<< "${input}"
  if [[ "${nonempty_updates}" -ne 1 || "${valid_bootstrap}" -ne 1 ]]; then
    echo "Aru: an empty remote accepts exactly one initial branch; push refused." >&2
    exit 1
  fi
  if [[ -x "${prior}" ]]; then
    printf '%s\n' "${input}" | "${prior}" "$@"
  fi
  exit 0
fi
default_branch=""
default_sha=""
while read -r first second third; do
  if [[ "${first}" == "ref:" && "${second}" == refs/heads/* && "${third}" == "HEAD" ]]; then
    default_branch="${second#refs/heads/}"
  elif [[ "${second}" == "HEAD" && "${first}" =~ ^[0-9a-fA-F]{40}$ ]]; then
    default_sha="${first}"
  fi
done <<< "${remote_snapshot}"
if [[ -z "${default_branch}" || -z "${default_sha}" || "${default_branch}" == -* ||
      "${default_branch}" == *..* || "${default_branch}" == *//* ]]; then
  echo "Aru: cannot resolve a safe remote default branch; push refused." >&2
  exit 1
fi

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${local_ref:-}" ]] && continue
  if [[ "${remote_ref}" == "refs/heads/${default_branch}" ]]; then
    echo "Aru: direct pushes to the default branch are refused; merge a PR." >&2
    exit 1
  fi
  [[ "${local_ref}" != refs/heads/* ]] && continue
  branch="${local_ref#refs/heads/}"
  if [[ ! "${local_sha}" =~ ^[0-9a-fA-F]{40}$ ||
        ! "${remote_sha}" =~ ^[0-9a-fA-F]{40}$ ]]; then
    echo "Aru: malformed branch update; push refused." >&2
    exit 1
  fi
  git cat-file -e "${default_sha}^{commit}" 2>/dev/null || {
    echo "Aru: remote default-branch commit is unavailable locally; push refused." >&2
    exit 1
  }
  if [[ "${remote_sha}" != "0000000000000000000000000000000000000000" ]]; then
    git cat-file -e "${remote_sha}^{commit}" 2>/dev/null || {
      echo "Aru: remote branch commit is unavailable locally; push refused." >&2
      exit 1
    }
  fi
  # Every push preflights the complete proposed PR, including prior feature work.
  diff_range="${default_sha}...${local_sha}"
  python3 "${enforcer}" --range "${diff_range}" --branch "${branch}" \
    --default-branch "${default_branch}"
done <<< "${input}"

if [[ -x "${prior}" ]]; then
  printf '%s\n' "${input}" | "${prior}" "$@"
fi
