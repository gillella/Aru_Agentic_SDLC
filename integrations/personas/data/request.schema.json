{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aru.invalid/schemas/personas/request-v1",
  "title": "Offline persona request; not authentication or execution authority",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "aru.personas.request/v1"
    },
    "synthetic": {
      "type": "boolean"
    },
    "request": {
      "$ref": "#/$defs/task"
    },
    "binding": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/binding"
        }
      ]
    },
    "context": {
      "$ref": "#/$defs/context"
    },
    "assignment": {
      "$ref": "#/$defs/review"
    },
    "current_assignment": {
      "$ref": "#/$defs/review"
    }
  },
  "required": [
    "schema",
    "binding",
    "context"
  ],
  "oneOf": [
    {
      "required": [
        "request"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "assignment"
            ]
          },
          {
            "required": [
              "current_assignment"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "assignment",
        "current_assignment"
      ],
      "not": {
        "required": [
          "request"
        ]
      }
    }
  ],
  "$defs": {
    "author": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "persona_id": {
          "type": "string",
          "enum": [
            "fable-architect",
            "opus-implementer",
            "sonnet-reviewer",
            "haiku-triage",
            "astra-implementer",
            "sol-implementer",
            "terra-maintainer",
            "luna-scout",
            "spark-pair",
            "grok-frontend",
            "composer-fixer",
            "flash-qa",
            "pro-design"
          ]
        },
        "account_id": {
          "type": "string",
          "enum": [
            "claude-subscription-1",
            "claude-subscription-2",
            "claude-subscription-3",
            "claude-subscription-4",
            "openai-codex",
            "cursor-account",
            "antigravity-account"
          ]
        },
        "actor": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "persona_id",
        "account_id",
        "actor"
      ]
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "worktree": {
          "type": "string",
          "minLength": 1
        },
        "kernel_root": {
          "type": "string"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "pr": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      },
      "required": [
        "worktree",
        "branch",
        "head"
      ]
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "task_class": {
          "enum": [
            null,
            "architecture_decision",
            "complex_implementation",
            "security_implementation",
            "bounded_implementation",
            "maintenance_fix",
            "repository_scout",
            "triage_documentation",
            "code_review",
            "qa_verification",
            "frontend_implementation",
            "rapid_ui_fix",
            "interactive_pair_edit",
            "design_evidence_analysis"
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risk_tier": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 3
        },
        "touches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "image"
            ]
          }
        },
        "persona_override": {
          "enum": [
            null,
            "fable-architect",
            "opus-implementer",
            "sonnet-reviewer",
            "haiku-triage",
            "astra-implementer",
            "sol-implementer",
            "terra-maintainer",
            "luna-scout",
            "spark-pair",
            "grok-frontend",
            "composer-fixer",
            "flash-qa",
            "pro-design"
          ]
        },
        "effort_override": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_override": {
          "type": [
            "string",
            "null"
          ]
        },
        "major_unresolved_decision": {
          "type": "boolean"
        },
        "allow_optional": {
          "type": "boolean"
        },
        "author_history": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/author"
          }
        },
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "handoff_reason": {
          "type": "string"
        },
        "nontrivial": {
          "type": "boolean"
        },
        "input_files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "project",
        "issue",
        "touches",
        "actor"
      ]
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "type": "string",
          "enum": [
            "claude-subscription-1",
            "claude-subscription-2",
            "claude-subscription-3",
            "claude-subscription-4",
            "openai-codex",
            "cursor-account",
            "antigravity-account"
          ]
        },
        "route": {
          "enum": [
            "claude-code",
            "codex",
            "cursor",
            "antigravity"
          ]
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "effort": {
          "enum": [
            "default",
            "low",
            "medium",
            "high",
            "xhigh"
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "outcome": {
          "enum": [
            "ok",
            "credits_required",
            "credits_exhausted",
            "session_limited",
            "rate_limited",
            "quota_exhausted",
            "unauthorized",
            "entitlement_missing",
            "provider_unavailable",
            "error"
          ]
        },
        "detail": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "authenticated": {
          "type": "boolean"
        },
        "identity_digest": {
          "type": "string"
        },
        "modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "text",
              "image"
            ]
          }
        }
      },
      "required": [
        "account_id",
        "route",
        "model_id",
        "effort",
        "observed_at",
        "outcome"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "aru.personas.capability-evidence/v1"
        },
        "authorizes_execution": {
          "type": "boolean"
        },
        "max_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 21600
        },
        "origin": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/probe"
          }
        }
      },
      "required": [
        "schema",
        "authorizes_execution",
        "observations"
      ]
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "type": "string",
          "enum": [
            "claude-subscription-1",
            "claude-subscription-2",
            "claude-subscription-3",
            "claude-subscription-4",
            "openai-codex",
            "cursor-account",
            "antigravity-account"
          ]
        },
        "allowed_projects": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "minItems": 1
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "max_sessions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "sessions_in_use": {
          "type": "integer",
          "minimum": 0
        },
        "unavailable_reason": {
          "type": "string"
        }
      },
      "required": [
        "account_id",
        "allowed_projects"
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "executable": {
          "type": "string",
          "minLength": 1
        },
        "workspace": {
          "type": "string",
          "minLength": 1
        },
        "declared_modalities": {
          "type": "array",
          "items": {
            "enum": [
              "text",
              "image"
            ]
          }
        },
        "modality_evidence": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "executable",
        "workspace"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "aru.personas.fleet-binding/v1"
        },
        "harnesses": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claude-code": {
              "$ref": "#/$defs/harness"
            },
            "codex": {
              "$ref": "#/$defs/harness"
            },
            "cursor": {
              "$ref": "#/$defs/harness"
            },
            "antigravity": {
              "$ref": "#/$defs/harness"
            }
          }
        },
        "accounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/account"
          }
        },
        "evidence": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/evidence"
            }
          ]
        },
        "enabled_optional": {
          "type": "array",
          "items": {
            "const": "spark-pair"
          }
        }
      },
      "required": [
        "schema",
        "harnesses",
        "accounts",
        "evidence"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "pr": {
          "type": "integer",
          "minimum": 1
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "issue": {
          "type": "integer",
          "minimum": 1
        },
        "risk_tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_persona": {
          "type": "string",
          "enum": [
            "fable-architect",
            "opus-implementer",
            "sonnet-reviewer",
            "haiku-triage",
            "astra-implementer",
            "sol-implementer",
            "terra-maintainer",
            "luna-scout",
            "spark-pair",
            "grok-frontend",
            "composer-fixer",
            "flash-qa",
            "pro-design"
          ]
        },
        "reviewer_actor": {
          "type": "string",
          "minLength": 1
        },
        "reviewer_account": {
          "type": "string",
          "enum": [
            "claude-subscription-1",
            "claude-subscription-2",
            "claude-subscription-3",
            "claude-subscription-4",
            "openai-codex",
            "cursor-account",
            "antigravity-account"
          ]
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/author"
          },
          "minItems": 1
        },
        "touches": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "authority_source": {
          "type": "string",
          "minLength": 1
        },
        "external_first_released": {
          "type": "boolean"
        },
        "external_first_reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repo",
        "pr",
        "head",
        "issue",
        "risk_tier",
        "authority",
        "reviewer_persona",
        "reviewer_actor",
        "reviewer_account",
        "authors",
        "touches",
        "authority_source",
        "external_first_released",
        "external_first_reason"
      ]
    }
  }
}
